# mcp-gateway environment variables. Copy to .env (`make bootstrap` does it) and adjust.
# Generated by scripts/gen_env_example.py from internal/config/config.go; edit the struct tags.
# Synthetic development values only. Never commit real secrets.

# ---- Gateway (mcp-gateway serve, migrate, dev-issuer) ----
# MCP Streamable HTTP listen address
MCPGW_MCP_ADDR=:8210
# Admin API and console listen address
MCPGW_ADMIN_ADDR=:8200
# Prometheus metrics listen address
MCPGW_METRICS_ADDR=:8211
# Log level (debug | info | warn | error)
MCPGW_LOG_LEVEL=info
# Upstream MCP servers (YAML)
MCPGW_UPSTREAMS_FILE=config/upstreams.yaml
# Per-tenant rate limits and daily budgets (YAML)
MCPGW_TENANTS_FILE=config/tenants.yaml
# Rego policy bundle directory
MCPGW_POLICY_DIR=policies
# How often the policy directory is checked for changes (0 disables)
MCPGW_POLICY_RELOAD_INTERVAL=5s
# Upstream tool catalog refresh interval
MCPGW_CATALOG_REFRESH=30s
# Timeout of one upstream call
MCPGW_UPSTREAM_TIMEOUT=10s
# OTLP/HTTP trace endpoint (host:port or URL); empty records spans without exporting
MCPGW_OTEL_ENDPOINT=
# app.node attribute on spans and step records (default: hostname)
MCPGW_NODE=
# Largest MCP request body accepted (NFR-9: 1 MiB); larger bodies get HTTP 413
MCPGW_MAX_BODY_BYTES=1048576
# Consecutive upstream failures that open its circuit breaker
MCPGW_BREAKER_THRESHOLD=5
# How long an open breaker rejects calls before one probe
MCPGW_BREAKER_COOLDOWN=30s
# Cache lifetime of a per-principal MCP server
MCPGW_PRINCIPAL_CACHE_TTL=60s
# JWKS URL of the token issuer
MCPGW_JWKS_URL=http://localhost:8212/.well-known/jwks.json
# Expected iss claim
MCPGW_JWT_ISSUER=mcp-gateway dev-issuer
# Expected aud claim
MCPGW_JWT_AUDIENCE=mcp-gateway
# JWKS cache lifetime
MCPGW_JWKS_CACHE_TTL=5m
# How long cached keys stay usable while the issuer is unreachable
MCPGW_JWKS_STALE_LIMIT=1h
# Postgres URL for the gateway role (mcpgw_app)
MCPGW_DATABASE_URL=postgres://mcpgw_app:mcpgw_app@localhost:8220/mcpgw?sslmode=disable
# Postgres URL of the schema owner, used by migrate
MCPGW_MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:8220/mcpgw?sslmode=disable
# Password set for role mcpgw_app by migrate (empty leaves it unchanged)
MCPGW_APP_DB_PASSWORD=mcpgw_app
# Password set for role mcpgw_readonly by migrate
MCPGW_READONLY_DB_PASSWORD=mcpgw_readonly
# Password set for role mcpgw_upstream (example upstreams) by migrate
MCPGW_UPSTREAM_DB_PASSWORD=mcpgw_upstream
# Redis URL (idempotency, rate limits, budgets)
MCPGW_REDIS_URL=redis://localhost:8230/0
# Idempotency store backend (redis | dynamodb | memory)
MCPGW_IDEMPOTENCY_STORE=redis
# How long completed idempotency records are kept
MCPGW_IDEMPOTENCY_TTL=24h
# Lifetime of an in-progress idempotency lock
MCPGW_IDEMPOTENCY_LOCK_TTL=30s
# DynamoDB endpoint override (dynamodb-local: http://localhost:8240)
MCPGW_DYNAMODB_ENDPOINT=
# DynamoDB idempotency table
MCPGW_DYNAMODB_TABLE=mcpgw_idempotency
# DynamoDB region
MCPGW_DYNAMODB_REGION=us-east-1
# Lifetime of a pending approval
MCPGW_APPROVAL_TTL=15m
# Approval webhook endpoint (empty disables delivery)
MCPGW_APPROVAL_WEBHOOK_URL=
# HMAC-SHA256 key for X-MCPGW-Signature
MCPGW_APPROVAL_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Injection score at or above which output is flagged (0..1)
MCPGW_INJECTION_THRESHOLD=0.5
# mark: flag only; block: withhold flagged text (mark | block)
MCPGW_INJECTION_MODE=mark
# Audit queue capacity (events)
MCPGW_AUDIT_BUFFER=10000
# Audit flush interval
MCPGW_AUDIT_FLUSH_INTERVAL=50ms
# Audit flush batch size
MCPGW_AUDIT_BATCH=500
# Maximum wait to enqueue an audit event before -32048
MCPGW_AUDIT_ENQUEUE_TIMEOUT=1ms
# Graceful shutdown budget (audit drain included)
MCPGW_SHUTDOWN_TIMEOUT=10s
# How often retention deletes old approvals, findings and delivered outbox rows
MCPGW_RETENTION_INTERVAL=1h
# Maximum upstream result (bytes)
MCPGW_MAX_RESULT_BYTES=4194304
# Maximum result stored for idempotent replay (bytes)
MCPGW_MAX_STORED_RESULT_BYTES=262144
# Maximum nesting depth of tool arguments
MCPGW_MAX_ARGS_DEPTH=32
# Set the Secure flag on console cookies (enable behind TLS)
MCPGW_CONSOLE_SECURE_COOKIES=false
# Dev issuer for the console persona sign-in; empty disables sign-in (development only)
MCPGW_DEV_ISSUER_URL=
# Allow the dev-issuer command to start (never in production)
MCPGW_DEV_ISSUER_ENABLED=false
# Dev issuer listen address
MCPGW_DEV_ISSUER_ADDR=:8212
# PEM RSA key for the dev issuer (generated at start when empty)
MCPGW_DEV_ISSUER_KEY_FILE=

# ---- Example upstreams (upstream-ledger, upstream-crm, upstream-orders) ----
# Listen address of an example upstream
MCPGW_UPSTREAM_ADDR=:8213
# Postgres URL used by the example upstreams (role mcpgw_upstream)
MCPGW_UPSTREAM_DATABASE_URL=postgres://mcpgw_upstream:mcpgw_upstream@localhost:8220/mcpgw?sslmode=disable
# Chaos: fraction of refund keys whose transaction stalls past the gateway timeout (0..1)
MCPGW_FAULT_TIMEOUT_RATE=0
# Chaos: stall duration for injected timeouts
MCPGW_FAULT_STALL=12s
# Demo: refund keys with this prefix stall mid-call (step 4 of make demo); empty disables
MCPGW_FAULT_STALL_KEY_PREFIX=

# ---- Clients and tools (demo-agent, loadgen, evalgen, make dev-token) ----
# Gateway MCP endpoint used by clients
MCPGW_GATEWAY_URL=http://localhost:8210/mcp
# Admin API base URL used by clients
MCPGW_ADMIN_URL=http://localhost:8200
# Bearer token for clients and .mcp.json (mint with make dev-token)
MCPGW_DEV_TOKEN=

# ---- Tests ----
# Use the running compose services instead of testcontainers in integration tests (1 to enable)
MCPGW_TEST_USE_COMPOSE=0
# Postgres superuser URL for integration tests (compose mode)
MCPGW_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:8220/postgres?sslmode=disable
# Redis URL for integration tests (compose mode)
MCPGW_TEST_REDIS_URL=redis://localhost:8230/15
# DynamoDB endpoint for integration tests (compose mode)
MCPGW_TEST_DYNAMODB_ENDPOINT=http://localhost:8240

# ---- Evals ----
# Budget for make eval-live (no model is called here: estimated cost USD 0.00)
LIVE_EVAL_BUDGET_USD=2
