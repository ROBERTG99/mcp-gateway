{
  "mcpServers": {
    "mcp-gateway": {
      "type": "http",
      "url": "http://localhost:8210/mcp",
      "headers": { "Authorization": "Bearer ${MCPGW_DEV_TOKEN}" }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.41", "--headless"]
    },
    "postgres-readonly": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres@0.6.2", "postgresql://mcpgw_readonly:mcpgw_readonly@localhost:8220/mcpgw"]
    }
  }
}
