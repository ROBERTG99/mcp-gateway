{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mcp-gateway Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "existingSecret", "auth", "idempotency", "upstreams", "tenants", "resources"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "existingSecret": { "type": "string", "minLength": 1 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jwksURL", "issuer", "audience"],
      "properties": {
        "jwksURL": { "type": "string", "pattern": "^https://" },
        "issuer": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store"],
      "properties": {
        "store": { "enum": ["redis", "dynamodb"] },
        "dynamodb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "table": { "type": "string", "minLength": 1 },
            "region": { "type": "string", "minLength": 1 },
            "endpoint": { "type": "string" }
          }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webhookURL": { "type": "string" },
        "ttl": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
      }
    },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["mark", "block"] },
        "threshold": { "type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$" }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "endpoint": { "type": "string" } }
    },
    "logLevel": { "enum": ["debug", "info", "warn", "error"] },
    "extraEnv": {
      "type": "object",
      "propertyNames": { "pattern": "^MCPGW_[A-Z0-9_]+$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "upstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
          "url": { "type": "string", "pattern": "^https?://" },
          "timeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
          "write_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "tenants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rate_per_second", "burst", "agent_rate_per_second", "agent_burst", "daily_budget"],
        "properties": {
          "rate_per_second": { "type": "number", "exclusiveMinimum": 0 },
          "burst": { "type": "integer", "minimum": 1 },
          "agent_rate_per_second": { "type": "number", "exclusiveMinimum": 0 },
          "agent_burst": { "type": "integer", "minimum": 1 },
          "daily_budget": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "existingConfigMap": { "type": "string" } }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admin", "mcp", "metrics"],
          "properties": {
            "admin": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "mcp": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "metrics": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["memory"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mcpFrom": { "type": "array", "items": { "type": "object" } },
        "adminFrom": { "type": "array", "items": { "type": "object" } },
        "metricsFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" }
  }
}
